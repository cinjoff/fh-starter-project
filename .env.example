# ─── Database ───────────────────────────────────────────────────────
# Required. Use the transaction pooler connection string from Supabase:
#   Dashboard → Settings → Database → Connection string → Transaction pooler (port 6543)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-[N]-[REGION].pooler.supabase.com:6543/postgres
# Tip: run `supabase status` (if linked) to get connection info.
DATABASE_URL=postgresql://postgres.ref:password@host:6543/postgres

# ─── Better Auth ────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=             # optional — without this, email verification is skipped
EMAIL_FROM=FH Starter <noreply@fh-starter.com>

# ─── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Sentry ─────────────────────────────────────────────────────────
# Leave NEXT_PUBLIC_SENTRY_DSN blank for local-only mode (SQLite store).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_LOCAL=true
NEXT_PUBLIC_SENTRY_LOCAL=true
