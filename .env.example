# ─── Database ───────────────────────────────────────────────────────
# Leave DATABASE_URL blank to use local SQLite (no Supabase needed for dev).
# For Supabase, use the **transaction pooler** connection string from:
#   Dashboard → Settings → Database → Connection string → Transaction pooler (port 6543)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-[N]-[REGION].pooler.supabase.com:6543/postgres
# Tip: the region prefix varies (aws-0, aws-1, etc.) — copy the exact URL from the dashboard.
# You can also run `supabase status` (if linked) to get connection info.
DATABASE_URL=

# ─── Better Auth ────────────────────────────────────────────────────
# Required when DATABASE_URL is set. Generate with: openssl rand -base64 32
# In local SQLite mode, a dev-only placeholder secret is used automatically.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=             # optional — without this, email verification is skipped
EMAIL_FROM=FH Starter <noreply@fh-starter.com>

# ─── Organizations (optional) ──────────────────────────────────────
# Set both to "true" to enable multi-tenant org UI (requires Postgres, not SQLite).
ENABLE_ORGANIZATIONS=
NEXT_PUBLIC_ENABLE_ORGANIZATIONS=

# ─── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Sentry ─────────────────────────────────────────────────────────
# Leave NEXT_PUBLIC_SENTRY_DSN blank for local-only mode (SQLite store).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_LOCAL=true
NEXT_PUBLIC_SENTRY_LOCAL=true